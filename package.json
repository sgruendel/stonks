{
    "name": "stonks",
    "version": "1.0.0",
    "description": "Stocks and Technical Indicators using Amazon DynamoDB",
    "main": "index.js",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "test:unit": "export $(cat .env.local | grep -v '^#' | xargs) && c8 --reporter=lcov --reporter=text mocha test/unit/*",
        "test:integration": "mocha test/integration/*",
        "test": "npm run test:unit"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sgruendel/stonks.git"
    },
    "keywords": [
        "stocks",
        "alphavantage"
    ],
    "author": "Stefan Gründel",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/sgruendel/stonks/issues"
    },
    "homepage": "https://github.com/sgruendel/stonks#readme",
    "dependencies": {
        "dayjs": "^1.11.23",
        "dynamoose": "^4.2.0",
        "node-fetch": "^3.3.2",
        "p-map": "^7.1.1",
        "p-queue": "^10.0.0",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.2",
        "c8": "^12.0.0",
        "chai": "^6.3.0",
        "eslint": "^10.13.0",
        "globals": "^17.13.0",
        "mocha": "^12.0.3"
    }
}
